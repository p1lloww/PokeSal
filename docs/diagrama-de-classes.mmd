---
title: Diagrama de Classes - Sistema de Batalhas PokeSal (Fase 03)
config:
  theme: base
  themeVariables:
    primaryColor: "#FFE0B2"
    primaryBorderColor: "#333333"
    primaryTextColor: "#111111"
    lineColor: "#333333"
    secondaryColor: "#FFE0B2"
    tertiaryColor: "#FFFFFF"
    fontFamily: "Helvetica, Arial, sans-serif"
  themeCSS: "text, tspan { font-family: Helvetica, Arial, sans-serif; }"
  htmlLabels: false
  class:
    htmlLabels: false
---
classDiagram
  direction TB

  %% ---------- Núcleo ----------
  class Battle {
    -trainerA: Trainer
    -trainerB: Trainer
    -battleground: Battleground
    -turns: List~Turn~
    -winner: Trainer
    +addTurn(turn: Turn) void
    +checkForWinner() void
    +isOver() boolean
    +getTrainerA() Trainer
    +getTrainerB() Trainer
    +getBattleground() Battleground
    +getTurns() List~Turn~
    +getWinner() Trainer
  }

  class Trainer {
    +MAX_ITEMS: int$
    -name: String
    -pokeSal: PokeSal
    -backpack: List~Item~
    +addItem(item: Item) void
    +removeItem(item: Item) void
    +getName() String
    +getPokeSal() PokeSal
    +getBackpack() List~Item~
  }

  class PokeSal {
    -name: String
    -description: String
    -hp: int
    -maxHp: int
    -baseAtk: int
    -baseDef: int
    -baseSpd: int
    -atkMultiplier: double
    -defMultiplier: double
    -spdMultiplier: double
    -elementType: ElementType
    -moves: List~Move~
    -passive: Passive
    -statusCondition: StatusCondition
    -activeEffects: Map~Integer, List~Effect~~
    +takeDamage(amount: double) void
    +heal(amount: double) void
    +applyAttackBuff(multiplier: double) void
    +applyDefenseBuff(multiplier: double) void
    +applySpeedBuff(multiplier: double) void
    +applyStatus(status: StatusCondition) void
    +clearStatus() void
    +receiveEffect(effect: Effect, currentTurn: int) void
    +expireEffects(currentTurn: int) void
    +restore() void
    +getHp() int
    +getMaxHp() int
    +getAtk() int
    +getDef() int
    +getSpd() int
    +getElementType() ElementType
    +getPassive() Passive
    +getStatusCondition() StatusCondition
    +getMoves() List~Move~
  }

  class Move {
    <<record>>
    name: String
    description: String
    type: ElementType
    power: int
    statusEffect: StatusCondition
    statusChance: double
    accuracy: int
  }

  class ElementType {
    <<enumeration>>
    FIRE
    WATER
    PLANT
  }

  class TypeMatchup {
    <<record>>
    attacker: ElementType
    defender: ElementType
  }

  class TypeChart {
    -CHART: Map~TypeMatchup, Double~$
    +getMultiplier(attacker: ElementType, defender: ElementType)$ double
    +getRegisteredMatchups()$ Set~TypeMatchup~
  }

  class DamageCalculatorService {
    <<service>>
    -randomGenerator: RandomGenerator
    -battlegroundService: BattlegroundService
    +calculateDamage(attacker: PokeSal, defender: PokeSal, move: Move, battleground: Battleground) DamageResult
  }

  class DamageResult {
    <<record>>
    damage: double
    hit: boolean
    critical: boolean
    battlegroundApplied: boolean
    +miss()$ DamageResult
  }

  %% ---------- Turnos ----------
  class Turn {
    -turnNumber: int
    -firstActor: PokeSal
    -secondActor: PokeSal
    -firstAction: TurnAction
    -secondAction: TurnAction
    +execute(pokeSal1: PokeSal, pokeSal2: PokeSal, action1: TurnAction, action2: TurnAction, battleground: Battleground) void
    +getTurnNumber() int
    +getFirstActor() PokeSal
    +getSecondActor() PokeSal
  }

  class TurnAction {
    <<interface>>
    +execute(actor: PokeSal, opponent: PokeSal, battleground: Battleground) void
  }

  class MoveAction {
    -move: Move
    -damageCalculatorService: DamageCalculatorService
    -randomGenerator: RandomGenerator
    -battleLogger: BattleLogger
    +execute(actor: PokeSal, opponent: PokeSal, battleground: Battleground) void
  }

  class ItemAction {
    -item: Item
    -trainer: Trainer
    -currentTurnNumber: int
    -battleLogger: BattleLogger
    +execute(actor: PokeSal, opponent: PokeSal, battleground: Battleground) void
  }

  class TurnActionFactory {
    -damageCalculatorService: DamageCalculatorService
    -randomGenerator: RandomGenerator
    -battleLogger: BattleLogger
    +createMoveAction(move: Move) MoveAction
    +createItemAction(item: Item, trainer: Trainer, currentTurnNumber: int) ItemAction
  }

  %% ---------- Casos de uso ----------
  class RunBattleUseCase {
    -battleCli: BattleCli
    -battlegroundService: BattlegroundService
    -resultRepository: ResultRepository
    -battleLogger: BattleLogger
    -trainerNotifier: TrainerNotifier
    -clock: Clock
    +ACTION_TIME_LIMIT: Duration$
    +CRITICAL_HP_RATIO: double$
    +execute(battle: Battle) void
    -promptActionWithinTimeLimit(trainer: Trainer, turnNumber: int) TurnAction
    -alertCriticalHp(battle: Battle, alertedPokeSals: Set~PokeSal~) void
    -saveResult(battle: Battle) void
    -endTurn(self: PokeSal, opponent: PokeSal, battleground: Battleground, turnNumber: int) void
  }

  class RunTournamentUseCase {
    -matchRunner: MatchRunner
    -battleCli: BattleCli
    +execute(trainers: List~Trainer~) Trainer
    -playRound(trainers: List~Trainer~) List~Trainer~
  }

  class MatchRunner {
    <<interface>>
    +run(trainerA: Trainer, trainerB: Trainer) BattleResult
  }

  class DefaultMatchRunner {
    -runBattleUseCase: RunBattleUseCase
    -randomGenerator: RandomGenerator
    +run(trainerA: Trainer, trainerB: Trainer) BattleResult
  }

  class BattleResult {
    <<record>>
    winner: Trainer
    loser: Trainer
    turnCount: int
    winnerPokeSal: String
    loserPokeSal: String
    +from(battle: Battle)$ BattleResult
  }

  %% ---------- Colaboradores injetados (Fase 03) ----------
  class RandomGenerator {
    <<interface>>
    +nextInt(bound: int) int
    +nextDouble() double
  }

  class DefaultRandomGenerator {
    -random: Random
    +nextInt(bound: int) int
    +nextDouble() double
  }

  class BattlegroundService {
    <<interface>>
    +isActive(battleground: Battleground) boolean
  }

  class DefaultBattlegroundService {
    -clock: Clock
    -weatherProvider: WeatherProvider
    +isActive(battleground: Battleground) boolean
  }

  class WeatherProvider {
    <<interface>>
    +getCurrentWeather() Weather
  }

  class RandomWeatherProvider {
    -weather: Weather
    +getCurrentWeather() Weather
  }

  class Clock {
    <<java.time>>
  }

  class ResultRepository {
    <<interface>>
    +save(result: BattleResult) void
    +findAll() List~BattleResult~
  }

  class InMemoryResultRepository {
    -results: List~BattleResult~
    +save(result: BattleResult) void
    +findAll() List~BattleResult~
  }

  class BattleLogger {
    <<interface>>
    +logBattleStart(trainerA: Trainer, trainerB: Trainer) void
    +logActionTimeout(trainer: Trainer) void
    +logAttack(attacker: PokeSal, defender: PokeSal, move: Move) void
    +logDamage(defender: PokeSal, damage: double, critical: boolean) void
    +logMiss(attacker: PokeSal, move: Move) void
    +logStatusEffect(target: PokeSal, status: StatusCondition) void
    +logStatusDamage(target: PokeSal, status: StatusCondition, hpLost: int) void
    +logBattlegroundEffect(battleground: Battleground, target: PokeSal) void
    +logItemUse(target: PokeSal, item: Item) void
    +logError(message: String, cause: Exception) void
  }

  class ConsoleBattleLogger {
    -out: PrintStream
    -trainerNames: Map~PokeSal, String~
    -label(pokeSal: PokeSal) String
  }

  class TrainerNotifier {
    <<interface>>
    +notifyCriticalHp(trainer: Trainer, pokeSal: PokeSal) void
  }

  class ConsoleTrainerNotifier {
    -out: PrintStream
  }

  %% ---------- Itens e efeitos ----------
  class Item {
    -name: String
    -description: String
    -effects: List~Effect~
    +useItem(pokeSal: PokeSal, currentTurn: int) void
    +getName() String
    +getDescription() String
    +getEffects() List~Effect~
  }

  class Effect {
    <<interface>>
    +applyEffect(pokeSal: PokeSal) void
    +removeEffect(pokeSal: PokeSal) void
    +isTemporary() boolean
  }

  class HealEffect {
    -healAmount: double
    +applyEffect(pokeSal: PokeSal) void
  }

  class SpeedBuffEffect {
    +applyEffect(pokeSal: PokeSal) void
    +removeEffect(pokeSal: PokeSal) void
    +isTemporary() boolean
  }

  class StatusHealEffect {
    <<abstract>>
    -curedStatus: Class~StatusCondition~
    +applyEffect(pokeSal: PokeSal) void
  }

  class SuperAntidote
  class BurnHeal
  class ParalyzeHeal

  %% ---------- Passivas ----------
  class Passive {
    <<interface>>
    +getName() String
    +getDescription() String
    +onSwitchIn(self: PokeSal, opponent: PokeSal) void
    +onDamageTaken(self: PokeSal, opponent: PokeSal, damageTaken: double) void
    +onTurnEnd(self: PokeSal) void
    +onAttack(self: PokeSal, battleground: Battleground) double
    +preventsStatusApplication(self: PokeSal) boolean
    +reset() void
  }

  class LowHpAttackBoost {
    <<abstract>>
    -elementType: ElementType
    -active: boolean
    +getDescription() String
    +onDamageTaken(self: PokeSal, opponent: PokeSal, damageTaken: double) void
    +reset() void
  }

  class Blaze {
    +getName() String
  }

  class Overgrow {
    +getName() String
  }

  class Torrent {
    +getName() String
  }

  class Intimidate {
    +onSwitchIn(self: PokeSal, opponent: PokeSal) void
  }

  class RainDish {
    +onSwitchIn(self: PokeSal, opponent: PokeSal) void
  }

  class LeafGuard {
    +preventsStatusApplication(self: PokeSal) boolean
  }

  class SolarPower {
    -active: boolean
    +onAttack(self: PokeSal, battleground: Battleground) double
    +onTurnEnd(self: PokeSal) void
    +reset() void
  }

  %% ---------- Condições de status ----------
  class StatusCondition {
    <<interface>>
    +getName() String
    +getDescription() String
    +onApply(self: PokeSal) void
    +onTurnEnd(self: PokeSal) void
    +onRemove(self: PokeSal) void
  }

  class Burn {
    +onApply(self: PokeSal) void
    +onTurnEnd(self: PokeSal) void
    +onRemove(self: PokeSal) void
  }

  class Poison {
    +onTurnEnd(self: PokeSal) void
  }

  class Paralyzed {
    +onApply(self: PokeSal) void
    +onRemove(self: PokeSal) void
  }

  %% ---------- Terrenos ----------
  class Battleground {
    <<interface>>
    +getName() String
    +getDescription() String
    +onTurnEnd(activePokeSal: PokeSal) void
    +modifyDamage(baseDamage: double, attackType: ElementType) double
    +isActive(conditions: BattlegroundConditions) boolean
  }

  class HotAsphalt {
    +modifyDamage(baseDamage: double, attackType: ElementType) double
    +isActive(conditions: BattlegroundConditions) boolean
  }

  class WaterPuddle {
    +modifyDamage(baseDamage: double, attackType: ElementType) double
    +isActive(conditions: BattlegroundConditions) boolean
  }

  class BattlegroundConditions {
    <<record>>
    time: LocalTime
    weather: Weather
    +isDaytime() boolean
  }

  class Weather {
    <<enumeration>>
    SUNNY
    CLOUDY
    RAINY
  }

  class CentralFlowerbed {
    +onTurnEnd(activePokeSal: PokeSal) void
  }

  %% ---------- Relações ----------
  Battle "1" --> "2" Trainer : participantes
  Battle "1" --> "1" Battleground : terreno
  Battle "1" *-- "0..*" Turn : histórico
  Trainer "1" *-- "1" PokeSal
  Trainer "1" o-- "0..2" Item : mochila
  PokeSal "1" *-- "1..4" Move
  PokeSal "1" *-- "1" Passive
  PokeSal "1" --> "0..1" StatusCondition
  PokeSal "1" --> "0..*" Effect : efeitos ativos
  PokeSal --> ElementType
  Move --> ElementType
  Move "1" --> "0..1" StatusCondition : statusEffect
  Item "1" *-- "1..*" Effect
  TypeChart --> TypeMatchup
  TypeMatchup --> ElementType

  Turn --> PokeSal
  Turn --> TurnAction
  TurnAction <|.. MoveAction
  TurnAction <|.. ItemAction
  MoveAction --> Move
  ItemAction --> Item
  ItemAction --> Trainer
  MoveAction --> DamageCalculatorService
  MoveAction --> RandomGenerator
  MoveAction --> BattleLogger
  ItemAction --> BattleLogger
  DamageCalculatorService ..> TypeChart
  DamageCalculatorService --> RandomGenerator
  DamageCalculatorService --> BattlegroundService
  DamageCalculatorService ..> DamageResult : cria
  TurnActionFactory ..> MoveAction : cria
  TurnActionFactory ..> ItemAction : cria

  RunBattleUseCase ..> Battle : conduz
  RunBattleUseCase --> BattlegroundService
  RunBattleUseCase --> ResultRepository
  RunBattleUseCase --> BattleLogger
  RunTournamentUseCase --> MatchRunner
  RunTournamentUseCase ..> BattleResult
  MatchRunner <|.. DefaultMatchRunner
  DefaultMatchRunner --> RunBattleUseCase
  DefaultMatchRunner --> RandomGenerator
  RunBattleUseCase --> TrainerNotifier
  RunBattleUseCase --> Clock
  RunBattleUseCase ..> BattleResult : cria
  BattleResult --> Trainer

  RandomGenerator <|.. DefaultRandomGenerator
  BattlegroundService <|.. DefaultBattlegroundService
  DefaultBattlegroundService --> Clock
  DefaultBattlegroundService --> WeatherProvider
  DefaultBattlegroundService ..> BattlegroundConditions : cria
  WeatherProvider <|.. RandomWeatherProvider
  RandomWeatherProvider ..> RandomGenerator : sorteio
  ResultRepository <|.. InMemoryResultRepository
  TrainerNotifier <|.. ConsoleTrainerNotifier
  InMemoryResultRepository o-- BattleResult
  BattleLogger <|.. ConsoleBattleLogger

  Effect <|.. HealEffect
  Effect <|.. SpeedBuffEffect
  Effect <|.. StatusHealEffect
  StatusHealEffect <|-- SuperAntidote
  StatusHealEffect <|-- BurnHeal
  StatusHealEffect <|-- ParalyzeHeal
  StatusHealEffect ..> StatusCondition : cura

  Passive <|.. LowHpAttackBoost
  LowHpAttackBoost <|-- Blaze
  LowHpAttackBoost <|-- Overgrow
  LowHpAttackBoost <|-- Torrent
  Passive <|.. Intimidate
  Passive <|.. RainDish
  Passive <|.. LeafGuard
  Passive <|.. SolarPower
  SolarPower ..> HotAsphalt : sinergia

  StatusCondition <|.. Burn
  StatusCondition <|.. Poison
  StatusCondition <|.. Paralyzed

  Battleground <|.. HotAsphalt
  Battleground <|.. WaterPuddle
  Battleground <|.. CentralFlowerbed
  Battleground ..> BattlegroundConditions
  BattlegroundConditions --> Weather

  %% ---------- Destaque: novidades da Fase 03 ----------
