  style BattlegroundService fill:#C8E6C9,stroke:#1B5E20,stroke-width:2px
  style WeatherProvider fill:#C8E6C9,stroke:#1B5E20,stroke-width:2px
  style ResultRepository fill:#C8E6C9,stroke:#1B5E20,stroke-width:2px
  style TrainerNotifier fill:#C8E6C9,stroke:#1B5E20,stroke-width:2px
  style MatchRunner fill:#C8E6C9,stroke:#1B5E20,stroke-width:2px
  style BattleLogger fill:#C8E6C9,stroke:#1B5E20,stroke-width:2px
  style DefaultRandomGenerator fill:#BBDEFB,stroke:#0D47A1,stroke-width:2px
  style DefaultBattlegroundService fill:#BBDEFB,stroke:#0D47A1,stroke-width:2px
  style RandomWeatherProvider fill:#BBDEFB,stroke:#0D47A1,stroke-width:2px
  style InMemoryResultRepository fill:#BBDEFB,stroke:#0D47A1,stroke-width:2px
  style ConsoleTrainerNotifier fill:#BBDEFB,stroke:#0D47A1,stroke-width:2px
  style ConsoleBattleLogger fill:#BBDEFB,stroke:#0D47A1,stroke-width:2px
  style BattleResult fill:#BBDEFB,stroke:#0D47A1,stroke-width:2px
  style DamageResult fill:#BBDEFB,stroke:#0D47A1,stroke-width:2px
  style BattlegroundConditions fill:#BBDEFB,stroke:#0D47A1,stroke-width:2px
  style Weather fill:#BBDEFB,stroke:#0D47A1,stroke-width:2px
  style TurnActionFactory fill:#BBDEFB,stroke:#0D47A1,stroke-width:2px
  style DefaultMatchRunner fill:#BBDEFB,stroke:#0D47A1,stroke-width:2px
  style RunTournamentUseCase fill:#BBDEFB,stroke:#0D47A1,stroke-width:2px

  note "Legenda\nVerde: interfaces novas da Fase 03\nAzul: implementações e classes novas\nLaranja: classes existentes"
